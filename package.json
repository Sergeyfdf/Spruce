{
  "name": "spruce",
  "version": "1.0.5",
  "description": "Minecraft Server Manager and Orchestrator",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron electron/main.js --no-sandbox --disable-gpu-sandbox",
    "electron": "electron electron/main.js --no-sandbox --disable-gpu-sandbox",
    "dist": "vite build && electron-builder --win",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@marzipan/updater": "file:../UpdateModule",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "lucide-react": "^0.475.0",
    "marked": "^18.1.0",
    "nat-upnp": "^1.1.1",
    "prismarine-nbt": "^2.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.spruce.minecraft",
    "productName": "Spruce",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/@marzipan/updater/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false,
      "include": "build/installer.nsh"
    }
  }
}
